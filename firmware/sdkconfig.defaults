# =============================================================================
# 1. Core Operating System & Task Stacks
# =============================================================================
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Extended Watchdog Timeout for DSI / Camera Bring-up
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15

# =============================================================================
# 2. ESP32-P4 Target Directives
# =============================================================================
CONFIG_IDF_TARGET="esp32p4"
CONFIG_IDF_TARGET_ESP32P4=y
# The ESP32-P4-NANO uses silicon v1.x. ESP-IDF 5.5+ defaults to v3.01+ (different memory layout);
# without this the bootloader/app crash at boot on <v3 chips.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# =============================================================================
# 3. External RAM (PSRAM) Configuration (32MB @ 200MHz)
# =============================================================================
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Run code and read-only data (incl. embedded face models) from PSRAM instead of flash.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# =============================================================================
# 4. Flash & Partition Table Configuration (16MB)
# =============================================================================
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Partition table at the default 0x8000 (bootloader is ~22 KB, fits below it); the layout
# itself is partitions.csv, written by espflash (`--partition-table` in .cargo/config.toml).

# =============================================================================
# 5. Processor L2 Cache Boost (ESP-DL Neural Engine Acceleration)
# =============================================================================
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# =============================================================================
# 6. Peripheral Drivers & Compiler Features
# =============================================================================
# -O2, as in Espressif's ESP-DL examples (inference speed; larger code than -Os)
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_BUFF_SIZE=256
CONFIG_COMPILER_CXX_RTTI=y

# Camera Controller, ISP & PPA Acceleration
CONFIG_ESP_DRIVER_CAM_CSI_ENABLE=y
CONFIG_ESP_DRIVER_ISP_ENABLE=y
CONFIG_PPA_ENABLE=y

# RMII EMAC Ethernet Driver
CONFIG_ETH_ENABLED=y
CONFIG_ETH_USE_ESP32P4_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_INPUT=y

# Power Management
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=n
CONFIG_PM_PROFILING=n

# =============================================================================
# 7. MIPI-DSI, LVGL 9 & esp_lvgl_port Directives
# =============================================================================
CONFIG_LCD_ENABLE_MIPI_DSI_PANEL=y

# LVGL 9 Configuration
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
# Panel text: 20 px by default (labels, buttons, keyboard), 28 px for the status line
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_USE_PPA=y
CONFIG_LV_DRAW_BUF_ALIGN=128


# OV5647 Camera Sensor Settings
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW10_1280X960_BINNING_45FPS=y
CONFIG_CAMERA_OV5647_DEFAULT_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW10_1280X960_BINNING_45FPS=y

# Face models are not part of the firmware build: they are loaded at runtime from the face_msr /
# face_mnp / face_feat flash partitions (images built by crates/model-packer, see the README).

# ESP-DL pixel conversions: the pipeline feeds the models RGB888 only. Each enabled pair
# instantiates large templates (~1 MB of code for all of them), so keep just the one in use.
CONFIG_PIX_CVT_RGB888_TO_RGB888_SUPPORT=y
# CONFIG_PIX_CVT_RGB565_TO_RGB565_SUPPORT is not set
# CONFIG_PIX_CVT_RGB565_TO_RGB888_SUPPORT is not set
# CONFIG_PIX_CVT_RGB565_TO_GRAY_SUPPORT is not set
# CONFIG_PIX_CVT_RGB565_TO_HSV_SUPPORT is not set
# CONFIG_PIX_CVT_RGB888_TO_RGB565_SUPPORT is not set
# CONFIG_PIX_CVT_RGB888_TO_GRAY_SUPPORT is not set
# CONFIG_PIX_CVT_RGB888_TO_HSV_SUPPORT is not set
# CONFIG_PIX_CVT_GRAY_TO_GRAY_SUPPORT is not set
# CONFIG_PIX_CVT_HSV_TO_HSV_MASK_SUPPORT is not set
# CONFIG_PIX_CVT_YUV_TO_RGB888_SUPPORT is not set
# CONFIG_PIX_CVT_YUV_TO_RGB565_SUPPORT is not set
# CONFIG_PIX_CVT_YUV_TO_GRAY_SUPPORT is not set
# CONFIG_PIX_CVT_YUV_TO_HSV_SUPPORT is not set
# CONFIG_PIX_CVT_YUV_TO_YUV_SUPPORT is not set

CONFIG_ESP_LCD_HX8394_SKIP_I2C_INIT=y